-                        error_bad_frame_next = 1'b1;
-                        error_bad_fcs_next = 1'b1;
-                    end
-                    state_next = STATE_IDLE;
+                    // end of packet - hold this byte back one cycle so the
+                    // FCS is compared against crc_state instead of crc_next
+                    m_axis_tvalid_next = 1'b0;
+                    state_next = STATE_LAST;
                 end else begin
                     state_next = STATE_PAYLOAD;
                 end
             end
+            STATE_LAST: begin
+                // last payload byte, with the verdict formed one cycle after
+                // the CRC that decides it: crc_state now holds what crc_next
+                // held, and the delay line has shifted by one to match
+                reset_crc = 1'b1;
+
+                m_axis_tdata_next = gmii_rxd_d5;
+                m_axis_tvalid_next = 1'b1;
+                m_axis_tlast_next = 1'b1;
+
+                if (gmii_rx_er_d1 || gmii_rx_er_d2 || gmii_rx_er_d3 || gmii_rx_er_d4) begin
+                    // error received in FCS bytes
+                    m_axis_tuser_next = 1'b1;
+                    error_bad_frame_next = 1'b1;
+                end else if ({gmii_rxd_d1, gmii_rxd_d2, gmii_rxd_d3, gmii_rxd_d4} == ~crc_state) begin
+                    // FCS good
+                    m_axis_tuser_next = 1'b0;
+                end else begin
+                    // FCS bad
+                    m_axis_tuser_next = 1'b1;
+                    error_bad_frame_next = 1'b1;
+                    error_bad_fcs_next = 1'b1;
+                end
+                state_next = STATE_IDLE;
+            end
             STATE_WAIT_LAST: begin
                 // wait for end of packet
 
