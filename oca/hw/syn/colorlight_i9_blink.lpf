# SPDX-License-Identifier: CERN-OHL-P-2.0
#
# Colorlight i9 v7.2 — bring-up step 2, two pins.
#
# Both balls and both IO_TYPEs are colorlight_i9.lpf's, unchanged, and
# the provenance argument for them is written there in full: read out of
# prjtrellis's iodb.json for LFE5U-45F / CABGA381, cross-checked against
# litex-boards' colorlight_i5.py and the vendor's own pin list. This file
# repeats the two lines rather than importing them because nextpnr has no
# include, and it constrains exactly two ports because the design has
# exactly two — which is the check: a stale LOCATE here is skipped in
# silence (ecp5/lpf.cc:144), but the port it stopped covering then fails
# the build with "IO '<name>' is unconstrained in LPF" (ecp5/main.cc:287).
# Two and two, and the counting closes.
#
# WHAT THIS BUILD CANNOT SETTLE. It has one output, so that output alone
# decides bank 6's VCCIO in the bitstream and the LED lights on a 2.5 V
# rail as readily as on a 3.3 V one. Whether bank 6 is actually at 3.3 V
# — the question that decides whether the RGMII receive pins later sit at
# the right threshold — is measured with a meter before this or any other
# bitstream is loaded. See colorlight_i9.lpf, "IO_TYPE: LVCMOS33, and
# what would follow from that being wrong": the dangerous combination
# produces no diagnostic anywhere in the flow.
#
# The FREQUENCY line is also the spelling check on clk25: a net that does
# not exist warns rather than passing quietly (common/kernel/basectx.cc:108).

FREQUENCY PORT "clk25" 25 MHZ;

LOCATE COMP "clk25" SITE "P3";
IOBUF  PORT "clk25" IO_TYPE=LVCMOS33;

LOCATE COMP "led_n" SITE "L2";
IOBUF  PORT "led_n" IO_TYPE=LVCMOS33;
